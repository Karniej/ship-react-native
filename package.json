{
  "name": "ship-react-native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/system"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:system": "npm run test --workspace @ship-rn/system",
    "test:watch": "jest --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build:system": "npm run build --workspace @ship-rn/system",
    "pretype-check": "npm run build:system",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run test:contracts && npm run test:system && npm test -- --passWithNoTests",
    "preapply": "npm run build:system",
    "apply": "tsx scripts/apply-config.ts",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "device:version": "agent-device --version",
    "device:help": "agent-device help workflow",
    "generate:assets": "node scripts/generate-assets.js",
    "db:seed": "node scripts/seed.js",
    "release": "node scripts/release.js",
    "podinstall": "npx pod-install",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prepare": "husky",
    "postinstall": "patch-package && npm run build:system",
    "test:contracts": "node --test .agents/skills/validate-skills/scripts/device-proof-contract.test.cjs && node .agents/skills/validate-skills/scripts/validate-system.cjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.2",
    "@expo/ui": "~57.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.90.14",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex": "^1.31.7",
    "expo": "^57.0.1",
    "expo-apple-authentication": "~57.0.0",
    "expo-asset": "~57.0.2",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.4",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.1",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-media-library": "~57.0.0",
    "expo-notifications": "~57.0.2",
    "expo-router": "~57.0.2",
    "expo-sharing": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.5",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "i18n-js": "^4.4.3",
    "posthog-react-native": "^4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^9.15.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@react-native/jest-preset": "^0.86.0",
    "@ship-rn/system": "file:packages/system",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "agent-device": "0.20.6",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^16.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jest": "^29.4.0",
    "jest-expo": "~57.0.0",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/packages/system/"
    ]
  }
}
