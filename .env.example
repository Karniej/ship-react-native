# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# CONVEX
# -----------------------------------------------------------------------------
# Get your deployment URL from: https://dashboard.convex.dev
# After running `npx convex dev`, copy the deployment URL

EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------------------------------------------------
# AI SERVICES (Convex Environment Variables)
# -----------------------------------------------------------------------------
# These are set in your Convex dashboard: Settings > Environment Variables
# Do NOT put them in .env - they should only be on the server
#
# Required for AI features:
# - OPENAI_API_KEY=sk-...
# - REPLICATE_API_TOKEN=r8_...
# - ELEVENLABS_API_KEY=...
#
# Optional (for OAuth):
# - GOOGLE_CLIENT_ID=...
# - GOOGLE_CLIENT_SECRET=...
# - APPLE_CLIENT_ID=...
# - APPLE_CLIENT_SECRET=...
#
# Optional (for RevenueCat webhooks):
# - REVENUECAT_WEBHOOK_SECRET=...

# -----------------------------------------------------------------------------
# SERVER-SIDE API KEYS (for Expo API Routes mode only)
# -----------------------------------------------------------------------------
# These are used when running in Expo API Routes mode (not Convex)
# Set these in your deployment environment (EAS, Vercel, Netlify)
# Do NOT prefix with EXPO_PUBLIC_ - these must stay server-side only

# OPENAI_API_KEY=sk-...
# REPLICATE_API_TOKEN=r8_...
# ELEVENLABS_API_KEY=...

# -----------------------------------------------------------------------------
# ANALYTICS
# -----------------------------------------------------------------------------
# PostHog - https://posthog.com/docs/libraries/react-native

EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# ERROR TRACKING
# -----------------------------------------------------------------------------
# Sentry - https://sentry.io/settings/projects/

EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# -----------------------------------------------------------------------------
# PURCHASES (Revenue Cat)
# -----------------------------------------------------------------------------
# RevenueCat - https://www.revenuecat.com/docs/getting-started

EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_key

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# Expo Push - https://docs.expo.dev/push-notifications/overview/

# EXPO_PUBLIC_PUSH_TOKEN_ENDPOINT=https://your-api.com/push-tokens

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Override feature flags for development

# EXPO_PUBLIC_ENABLE_VIDEO_GENERATION=true
# EXPO_PUBLIC_ENABLE_BETA_FEATURES=true

# -----------------------------------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------------------------------
# Set to 'development' for local testing, 'production' for release

EXPO_PUBLIC_APP_ENV=development
