{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // TypeScript settings
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // File associations
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.ts": "typescript"
  },

  // Exclude from search
  "search.exclude": {
    "**/node_modules": true,
    "**/ios/Pods": true,
    "**/android/build": true,
    "**/.expo": true,
    "**/coverage": true,
    "**/.git": true
  },

  // File nesting
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .npmrc, .nvmrc",
    "tsconfig.json": "tsconfig.*.json",
    ".eslintrc.js": ".eslintignore, .prettierrc, .prettierignore",
    "app.json": "app.config.js, eas.json, metro.config.js, babel.config.js"
  },

  // Emmet for JSX
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },

  // ESLint settings
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Prettier settings
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // React Native specific
  "react-native-tools.packagerPort": 8081,

  // Path intellisense
  "path-intellisense.mappings": {
    "@": "${workspaceRoot}"
  },

  // Tailwind (if using NativeWind)
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  // Jest
  "jest.autoRun": "off",
  "jest.showCoverageOnLoad": false
}
